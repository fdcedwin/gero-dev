---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Cta from "@/components/site/Cta.astro";
import { getCategoryMap, type Category } from "@/lib/businesses";

// Category options come from categories.yaml, so submissions use the same keys as listings.
const categories = [...(await getCategoryMap()).values()];
const byName = (a: Category, b: Category) => a.data.name.localeCompare(b.data.name);
const categoryGroups = categories
  .filter((category) => !category.data.parent)
  .sort(byName)
  .map((parent) => ({
    parent,
    options: [
      parent,
      ...categories.filter((category) => category.data.parent?.id === parent.id).sort(byName),
    ],
  }));
---

<BaseLayout title="List Your Business | What's On Gero">
  <section class="hero">
    <div class="container">
      <div class="hero__copy">
        <span class="hero__copy-eyebrow">WHAT’S ON GERO:</span>
        <h1 class="hero__copy-heading">List Your Business</h1>
        <div class="hero__copy-text">
          <p>Join Geraldton's local directory and get discovered by locals and visitors.</p>
        </div>
      </div>

      <div class="hero__image">
        <picture>
          <!-- Desktop -->
          <source media="(min-width: 980px)" srcset="/images/hero-desktop.jpg" />

          <!-- Tablet -->
          <source media="(min-width: 768px)" srcset="/images/hero-tablet.jpg" />

          <!-- Mobile (fallback) -->
          <img src="/images/hero-mobile.jpg" alt="" />
        </picture>
      </div>
    </div>
  </section>

  <section class="wave">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1440"
      height="100"
      viewBox="0 0 1440 100"
      fill="none"
    >
      <path
        d="M0 100H1440V25C1440 25 1278.82 75 1080 75C881.18 75 558.82 0 360 0C161.18 0 5.22 75 0 75V100Z"
        fill="white"
      />
    </svg>
  </section>

  <section class="why-list">
    <div class="container">
      <div class="why-list-box">
        <h2 class="why-list-box__heading">Why list with us?</h2>
        <ul class="why-list-box__items">
          <li>Reach thousands of locals and visitors.</li>
          <li>Improve your visibility in local searches.</li>
          <li>Build trust with genuine customer reviews.</li>
          <li>Flexible plans to suit every business.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="business-form">
    <div class="container">
      {/*
        Handled by Netlify Forms: Netlify finds this form in the built HTML at deploy time
        (data-netlify + the hidden form-name field) and stores submissions in the Netlify UI.
        bot-field is a honeypot; Netlify also runs Akismet spam filtering on every submission.
      */}
      <form
        name="submit-business"
        method="POST"
        action="/submit-business/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="submit-business" />
        <p class="visually-hidden" aria-hidden="true">
          <label>
            Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="business-form__section">
          <div class="business-form__text">
            <h3>Business Details</h3>

            <p>Tell us about your business so we can list it in the directory.</p>

            <div class="heading-line" aria-hidden="true"></div>
          </div>

          <div class="business-form__fields">
            <fieldset class="business-form__fieldset">
              <div class="business-form__fieldset-head">
                <label for="business-name">
                  Business Name <span aria-hidden="true">*</span>
                </label>

                <small class="error none" id="business-name-error">
                  {" "}
                  Cannot be empty{" "}
                </small>
              </div>

              <input
                type="text"
                class="business-form__fieldset-input"
                name="business_name"
                id="business-name"
                autocomplete="organization"
                placeholder="e.g. What’s On Gero"
                maxlength="120"
                aria-describedby="business-name-error"
                required
              />
            </fieldset>

            <fieldset class="business-form__fieldset">
              <div class="business-form__fieldset-head">
                <label for="category">
                  Category <span aria-hidden="true">*</span>
                </label>

                <small class="error none" id="category-error">
                  {" "}
                  Please select a category{" "}
                </small>
              </div>

              <select
                class="business-form__fieldset-input business-form__fieldset-select"
                name="category"
                id="category"
                aria-describedby="category-error"
                required
              >
                <option value="">Select a category</option>
                {categoryGroups.map(({ parent, options }) => (
                  <optgroup label={parent.data.name}>
                    {options.map((category) => (
                      <option value={category.id}>{category.data.name}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </fieldset>

            <fieldset class="business-form__fieldset">
              <div class="business-form__fieldset-head">
                <label for="short-description">
                  Short Description <span aria-hidden="true">*</span>
                </label>

                <small class="error none" id="short-description-error">
                  {" "}
                  Cannot be empty{" "}
                </small>
              </div>

              <textarea
                name="short_description"
                class="business-form__fieldset-input business-form__fieldset-textarea business-form__fieldset-textarea--short"
                maxlength="140"
                id="short-description"
                placeholder="Write a short description of your business (max. 140 characters)"
                aria-describedby="short-description-error"
                required
              ></textarea>

              <div class="textarea-count-wrap">
                <span class="textarea-count">0</span> / 140
              </div>
            </fieldset>

            <fieldset class="business-form__fieldset">
              <div class="business-form__fieldset-head">
                <label for="full-description">
                  Full Description <span aria-hidden="true">*</span>
                </label>

                <small class="error none" id="full-description-error">
                  {" "}
                  Cannot be empty{" "}
                </small>
              </div>

              <textarea
                name="full_description"
                class="business-form__fieldset-input business-form__fieldset-textarea business-form__fieldset-textarea--full"
                maxlength="1000"
                id="full-description"
                placeholder="Tell customers about your business, products, and what makes you unique... (max. 1,000 characters)"
                aria-describedby="full-description-error"
                required
              ></textarea>

              <div class="textarea-count-wrap">
                <span class="textarea-count">0</span> / 1,000
              </div>
            </fieldset>
          </div>
        </div>

        <hr class="blue-line" />

        <div class="business-form__fields">
          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="address">
                Street Address <span aria-hidden="true">*</span>
              </label>

              <small class="error none" id="address-error">
                {" "}
                Cannot be empty{" "}
              </small>
            </div>

            <input
              type="text"
              class="business-form__fieldset-input"
              name="address"
              id="address"
              autocomplete="street-address"
              placeholder="e.g. 186 Marine Terrace, Geraldton WA 6530"
              aria-describedby="address-error"
              required
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="suburb">
                Suburb <span aria-hidden="true">*</span>
              </label>

              <small class="error none" id="suburb-error">
                {" "}
                Cannot be empty{" "}
              </small>
            </div>

            <input
              type="text"
              class="business-form__fieldset-input"
              name="suburb"
              id="suburb"
              autocomplete="address-level2"
              placeholder="e.g. Webberton"
              aria-describedby="suburb-error"
              required
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="phone-number">
                Phone Number <span aria-hidden="true">*</span>
              </label>

              <small class="error none" id="phone-number-error">
                {" "}
                Invalid phone number{" "}
              </small>
            </div>

            {/* Same rule as the listing schema: digits, spaces, +, - and (). */}
            <input
              type="tel"
              class="business-form__fieldset-input"
              name="phone_number"
              id="phone-number"
              autocomplete="tel"
              inputmode="tel"
              placeholder="(08) 1234 5678"
              pattern="[+\(\)\d\s\-]{6,20}"
              aria-describedby="phone-number-error"
              required
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="email-address">
                Email Address <span aria-hidden="true">*</span>
              </label>

              <small class="error none" id="email-address-error">
                {" "}
                Invalid email{" "}
              </small>
            </div>

            <input
              type="email"
              class="business-form__fieldset-input"
              name="email_address"
              id="email-address"
              autocomplete="email"
              placeholder="user@domain.au"
              aria-describedby="email-address-error"
              required
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="website"> Website </label>

              <small class="error none" id="website-error">
                {" "}
                Must start with https://{" "}
              </small>
            </div>

            <input
              type="url"
              class="business-form__fieldset-input"
              name="website"
              id="website"
              inputmode="url"
              placeholder="https://www.yourbusiness.com.au"
              pattern="https://.+"
              aria-describedby="website-error"
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="facebook"> Facebook </label>

              <small class="error none" id="facebook-error">
                {" "}
                Invalid Facebook URL{" "}
              </small>
            </div>

            <input
              type="url"
              class="business-form__fieldset-input"
              name="facebook"
              id="facebook"
              inputmode="url"
              placeholder="https://www.facebook.com/yourbusiness"
              pattern="https://([a-z0-9\-]+\.)*facebook\.com(/.*)?"
              aria-describedby="facebook-error"
            />
          </fieldset>

          <fieldset class="business-form__fieldset">
            <div class="business-form__fieldset-head">
              <label for="instagram"> Instagram </label>

              <small class="error none" id="instagram-error">
                {" "}
                Invalid Instagram URL{" "}
              </small>
            </div>

            <input
              type="url"
              class="business-form__fieldset-input"
              name="instagram"
              id="instagram"
              inputmode="url"
              placeholder="https://www.instagram.com/yourbusiness"
              pattern="https://([a-z0-9\-]+\.)*instagram\.com(/.*)?"
              aria-describedby="instagram-error"
            />
          </fieldset>
        </div>

        <div class="business-form__actions">
          <button type="submit" class="btn">
            SUBMIT LISTING
          </button>
        </div>
      </form>
    </div>
  </section>

  <Cta />

  <script>
    const form = document.querySelector<HTMLFormElement>("form[name='submit-business']");
    const fields = form
      ? [
          ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
            ".business-form__fieldset-input",
          ),
        ]
      : [];

    // multiple textareas with counters
    form
      ?.querySelectorAll<HTMLTextAreaElement>(".business-form__fieldset-textarea")
      .forEach((textarea) => {
        const count = textarea
          .closest(".business-form__fieldset")
          ?.querySelector(".textarea-count");
        if (!count) return;

        const updateCount = () => {
          count.textContent = String(textarea.value.length);
        };

        textarea.addEventListener("input", updateCount);
        updateCount();
      });

    /** Shows or hides the field's error message; returns whether the field is valid. */
    function validate(field: (typeof fields)[number]): boolean {
      // Whitespace-only answers count as empty.
      if (field.value.trim() === "") field.value = "";
      const valid = field.checkValidity();
      const errorId = field.getAttribute("aria-describedby");
      const error = errorId ? document.getElementById(errorId) : null;
      error?.classList.toggle("none", valid);
      if (valid) field.removeAttribute("aria-invalid");
      else field.setAttribute("aria-invalid", "true");
      return valid;
    }

    if (form) {
      const submitButton = form.querySelector<HTMLButtonElement>("button[type=submit]");

      // With JS we show the design's inline errors; without it, the browser's own validation still runs.
      form.noValidate = true;

      form.addEventListener("submit", (event) => {
        const invalid = fields.filter((field) => !validate(field));
        if (invalid.length > 0) {
          event.preventDefault();
          invalid[0]?.focus();
          return;
        }
        // Prevent double submissions; re-enable if the user comes back with the Back button.
        submitButton?.setAttribute("disabled", "");
      });
      window.addEventListener("pageshow", () => submitButton?.removeAttribute("disabled"));

      // Once a field has been flagged, re-check it as the user fixes it.
      for (const field of fields) {
        const recheck = () => {
          if (field.hasAttribute("aria-invalid")) validate(field);
        };
        field.addEventListener("input", recheck);
        field.addEventListener("change", recheck);
        field.addEventListener("blur", () => {
          if (field.value !== "") validate(field);
        });
      }
    }
  </script>
</BaseLayout>
